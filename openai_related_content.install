<?php

/**
 * @file
 * Install, update and uninstall functions for the OpenAI Related Content module.
 */

/**
 * Implements hook_schema().
 */
function openai_related_content_schema() {
  $schema = [];

  $schema['openai_related_content_exclude'] = [
    'description' => 'Nodes excluded from appearing in AI-related content recommendations.',
    'fields' => [
      'nid' => [
        'description' => 'Node ID.',
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
      ],
    ],
    'primary key' => ['nid'],
  ];

  return $schema;
}

/**
 * Create exclusion table.
 */
function openai_related_content_update_7001() {
  $schema = openai_related_content_schema();
  if (!db_table_exists('openai_related_content_exclude')) {
    db_create_table('openai_related_content_exclude', $schema['openai_related_content_exclude']);
  }
}

/**
 * Ensure the view_display config is set to a default value.
 *
 * @param Config $config
 *   The openai_related_content.settings config object.
 */
function openai_related_content_ensure_view_display(Config $config) {
  if (empty($config->get('view_display'))) {
    $config->set('view_display', 'openai_related_content:block_1');
    $config->save();
  }
}

/**
 * Implements hook_install().
 *
 * Backdrop automatically installs default configuration shipped in
 * config/install when a module is enabled. Additionally, Backdrop will
 * automatically create any database tables declared in `hook_schema()`
 * during module installation, so there is no need to manually copy
 * configuration files or create schema here. The function can remain empty.
 */
function openai_related_content_install() {
  $config = config('openai_related_content.settings');
  openai_related_content_ensure_view_display($config);
}

/**
 * Set the default view display if not already set.
 */
function openai_related_content_update_1001() {
  $config = config('openai_related_content.settings');
  openai_related_content_ensure_view_display($config);
}
